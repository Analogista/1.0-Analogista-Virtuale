{
  "entities": {
    "UserSession": {
      "title": "User Session",
      "description": "A recorded analog session with its results and metadata.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the user who owns this session" },
        "userName": { "type": "string", "description": "Name of the client/user" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" },
        "data": { "type": "object", "description": "The actual results of the session" },
        "status": { "type": "string", "enum": ["in_progress", "completed"], "description": "Current status of the session" }
      },
      "required": ["userId", "createdAt", "status"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Internal user record.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "sessions/{sessionId}": {
      "schema": "UserSession",
      "description": "Collection of all diagnostic sessions."
    },
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data."
    }
  }
}
